{
  "name": "credless",
  "version": "0.1.0",
  "description": "Signed-in, multi-user Playwright end-to-end tests that AI coding agents (Claude Code, Cursor, Codex) can run without your credentials: personas, a key broker, an egress guard and leak-proof evidence.",
  "keywords": [
    "playwright",
    "e2e",
    "end-to-end-testing",
    "test-automation",
    "authentication-testing",
    "multi-user",
    "test-accounts",
    "personas",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills",
    "secrets",
    "secret-scanning",
    "egress-proxy",
    "devsecops",
    "qa",
    "typescript"
  ],
  "homepage": "https://github.com/Prathyush-KKK/credless#readme",
  "bugs": "https://github.com/Prathyush-KKK/credless/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prathyush-KKK/credless.git",
    "directory": "packages/kit"
  },
  "license": "Apache-2.0",
  "author": "Prathyush K (https://github.com/Prathyush-KKK)",
  "type": "module",
  "sideEffects": [
    "./dist/worker-shim.js"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "credless": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./global-setup": {
      "types": "./dist/global-setup.d.ts",
      "default": "./dist/global-setup.js"
    },
    "./worker-shim": {
      "types": "./dist/worker-shim.d.ts",
      "default": "./dist/worker-shim.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "demo",
    "skills",
    "templates",
    "contract",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-demo.ts",
    "typecheck": "tsc --noEmit -p .",
    "unit": "vitest run",
    "selftest": "node src/cli.ts run --target selftest --native",
    "pack:check": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64 <2"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "fflate": "0.8.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.1",
    "playwright-ctrf-json-reporter": "0.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
