{
  "name": "kit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace of credless: signed-in, multi-user Playwright end-to-end tests that AI coding agents (Claude Code, Cursor, Codex) can run without your credentials: personas, a key broker, an egress guard and leak-proof evidence.",
  "keywords": [
    "playwright",
    "e2e",
    "end-to-end-testing",
    "test-automation",
    "authentication-testing",
    "multi-user",
    "test-accounts",
    "personas",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills",
    "secrets",
    "secret-scanning",
    "egress-proxy",
    "devsecops",
    "qa",
    "typescript"
  ],
  "homepage": "https://github.com/Prathyush-KKK/credless#readme",
  "bugs": "https://github.com/Prathyush-KKK/credless/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prathyush-KKK/credless.git"
  },
  "license": "Apache-2.0",
  "author": "Prathyush K (https://github.com/Prathyush-KKK)",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm unit && pnpm contract:check && pnpm catalog:check && pnpm skill:check && pnpm skill:validate && pnpm check-tests && pnpm org-gate && pnpm test:action",
    "test": "pnpm check && pnpm selftest",
    "build": "pnpm --filter ./packages/kit build && pnpm --filter ./packages/kit pack:check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "unit": "pnpm -r --if-present run unit",
    "selftest": "pnpm --filter ./packages/kit selftest",
    "demo": "node packages/kit/src/cli.ts demo",
    "contract:check": "node scripts/contract-check.ts",
    "catalog:check": "node scripts/catalog-check.ts",
    "skill:sync": "node scripts/skill-sync.mjs",
    "skill:check": "node scripts/skill-sync.mjs --check",
    "skill:validate": "node scripts/skill-validate.mjs",
    "check-tests": "node packages/kit/src/cli.ts check-tests apps/demo/e2e packages/kit/templates/e2e",
    "org-gate": "node scripts/org-gate.mjs",
    "test:action": "node --test action/summary.test.mjs",
    "pack:check": "pnpm --filter ./packages/kit build && pnpm --filter ./packages/kit pack:check",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "verify": "pnpm check && pnpm selftest && pnpm demo && pnpm build && pnpm smoke:pack",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "publint": "0.3.25",
    "typescript": "5.9.3"
  }
}
